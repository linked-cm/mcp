{
  "name": "@linked.cm/mcp",
  "description": "Connected agents for Linked apps over the Model Context Protocol: an agent reads, changes and calls an app's shapes as the person it works for, within declared capabilities.",
  "author": {
    "name": "Semantu"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "version": "0.0.0",
  "linked": {
    "kind": "assets"
  },
  "type": "module",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "//types": "Correct as written, do not 'fix' it: typesVersions below is applied to the types field too, so \"index.d.ts\" resolves to lib/esm/index.d.ts. Writing that literal path applies the mapping twice (lib/esm/lib/esm/index.d.ts) and breaks node10 resolution. Verify with ts.resolveModuleName under node10 AND bundler, not by looking for the file on disk.",
  "types": "index.d.ts",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "linked dev",
    "build": "linked build",
    "typecheck": "tsc -p tsconfig-esm.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "linked",
    "linked data",
    "semantic web",
    "web3"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.41.0",
    "@linked.cm/mcp-ont": "file:../mcp-ont",
    "@modelcontextprotocol/sdk": "1.32.2",
    "n3": "^1.26.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.57.0",
    "@_linked/server": "^3.14.1",
    "@_linked/server-utils": "^1.17.0",
    "@changesets/cli": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.14",
    "express": "^4.18.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@_linked/server": "^3.14.1",
    "@_linked/server-utils": "^1.18.0"
  }
}
